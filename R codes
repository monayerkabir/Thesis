# ------------------------------------------------------------
# PATTERN A: within a station's block (in file/row order), does
# the date ever jump BACKWARD? This catches mislabeled-year rows
# like the 10208 case -- even ones that don't happen to collide
# with a real existing date (so wouldn't show up as a "duplicate").
# ------------------------------------------------------------
find_backward_jumps <- function(df, value_col) {
  df %>%
    arrange(St_ID, excel_row) %>%
    group_by(St_ID) %>%
    mutate(prev_date = lag(date)) %>%
    filter(!is.na(prev_date), date < prev_date) %>%
    ungroup() %>%
    select(St_ID, excel_row, Year, Month, Date, prev_date, date, all_of(value_col))
}

