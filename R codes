# ============================================================
# Add 1-year and 2-year LAGGED production/climate variables
# Lag = value from (birth_year - lag), i.e. years prior to birth
# Run AFTER map_production_to_mics.R (needs agri_national, ch_merged)
# ============================================================

library(dplyr)

# ------------------------------------------------------------
# Generic helper: shift agri_national's year forward by `lag`,
# suffix every non-key column with _lagN, then it can be joined
# on the CHILD's birth_year directly.
#
# Why shift forward: a row originally at year (Y - lag) becomes
# labelled (Y - lag) + lag = Y after the mutate, so joining on
# birth_year = Y correctly pulls in the (Y - lag) data.
# ------------------------------------------------------------
make_lagged_agri <- function(agri, lag, key = "birth_year") {
  agri %>%
    mutate(!!key := .data[[key]] + lag) %>%
    rename_with(~ paste0(.x, "_lag", lag), .cols = -all_of(key))
}

agri_lag1 <- make_lagged_agri(agri_national, lag = 1)
agri_lag2 <- make_lagged_agri(agri_national, lag = 2)

# ------------------------------------------------------------
# Join lag0 (contemporaneous, birth year), lag1, lag2 onto ch_merged
# ------------------------------------------------------------
ch_merged_agri <- ch_merged %>%
  left_join(agri_national, by = "birth_year") %>%   # lag0 (birth year itself)
  left_join(agri_lag1,      by = "birth_year") %>%  # lag1 (birth year - 1)
  left_join(agri_lag2,      by = "birth_year")       # lag2 (birth year - 2)

# ------------------------------------------------------------
# Diagnostics: match rate for each lag (lag1/lag2 will have more
# NAs at the early edge of your agri series, e.g. children born
# in 1980 or 1981 can't get a full lag2 since data starts 1980)
# ------------------------------------------------------------
cat("Match rate, lag0 (rice production):",
    mean(!is.na(ch_merged_agri$rice_production_tons)), "\n")
cat("Match rate, lag1 (rice production):",
    mean(!is.na(ch_merged_agri$rice_production_tons_lag1)), "\n")
cat("Match rate, lag2 (rice production):",
    mean(!is.na(ch_merged_agri$rice_production_tons_lag2)), "\n")

cat("\nBirth years with an incomplete lag2 window (near data start):\n")
ch_merged_agri %>%
  filter(!is.na(birth_year), is.na(rice_production_tons_lag2)) %>%
  count(birth_year) %>%
  print(n = Inf)

