# STEP 4: quantify excluded-station impact, then krige daily
# station data onto the 64 district centroids
# ============================================================
library(dplyr)
library(sf)
library(gstat)
library(readr)
library(purrr)
library(tidyr)

# ------------------------------------------------------------
# 0. Quantify what we lose by excluding the 9 unmatched stations
# ------------------------------------------------------------
cat("=== Impact of excluding unmatched stations ===\n")
station_day %>%
  mutate(matched = !is.na(lat)) %>%
  group_by(matched) %>%
  summarise(n_rows = n(), n_stations = n_distinct(St_ID),
            pct_of_total = round(100 * n() / nrow(station_day), 1))

# keep only stations we can actually place on the map
station_day_geo <- station_day %>% filter(!is.na(lat), !is.na(lon))

cat("\nUsable for kriging:", n_distinct(station_day_geo$St_ID), "stations,",
    nrow(station_day_geo), "station-day rows\n")

# ------------------------------------------------------------
# 1. District centroids as an sf object (kriging targets)
# ------------------------------------------------------------
district_coords <- read_csv("districts_lat_lon.csv", show_col_types = FALSE)
district_sf <- st_as_sf(district_coords, coords = c("lon", "lat"), crs = 4326)

# ------------------------------------------------------------
# 2. Fit ONE pooled variogram per calendar month per variable.
#    Rationale: with ~35 stations, a fresh variogram per DAY is
#    unstable (discussed earlier). Pooling many days within the
#    same month gives enough pairs for a stable fit while still
#    letting the spatial structure vary seasonally (e.g. monsoon
#    rainfall/temperature gradients differ from winter ones).
# ------------------------------------------------------------
fit_monthly_variogram <- function(data, value_col, month_num) {
  month_data <- data %>%
    filter(Month == month_num, !is.na(.data[[value_col]])) %>%
    st_as_sf(coords = c("lon", "lat"), crs = 4326, remove = FALSE)
  
  if (nrow(month_data) < 30) return(NULL)  # not enough pairs, skip
  
  v_emp <- variogram(as.formula(paste(value_col, "~ 1")), month_data)
  tryCatch(
    fit.variogram(v_emp, vgm(psill = NA, model = "Sph", range = NA, nugget = NA)),
    error = function(e) NULL
  )
}

cat("\nFitting monthly variograms (MaxT)...\n")
maxt_variograms <- map(1:12, ~ fit_monthly_variogram(station_day_geo, "MaxT", .x))
names(maxt_variograms) <- month.abb
print(maxt_variograms)

cat("\nFitting monthly variograms (MinT)...\n")
mint_variograms <- map(1:12, ~ fit_monthly_variogram(station_day_geo, "MinT", .x))
names(mint_variograms) <- month.abb
print(mint_variograms)

# ------------------------------------------------------------
# 3. Krige ONE day, given that day's station readings + the
#    matching month's fixed variogram model
# ------------------------------------------------------------
krige_one_day <- function(day_data, value_col, vgm_model, target_sf) {
  day_sf <- day_data %>%
    filter(!is.na(.data[[value_col]])) %>%
    st_as_sf(coords = c("lon", "lat"), crs = 4326, remove = FALSE)
  
  if (nrow(day_sf) < 5 || is.null(vgm_model)) return(NULL)  # too few stations that day
  
  result <- tryCatch(
    krige(as.formula(paste(value_col, "~ 1")), day_sf, target_sf, model = vgm_model),
    error = function(e) NULL
  )
  if (is.null(result)) return(NULL)
  
  tibble(
    district = target_sf$district,
    pred = result$var1.pred,
    var = result$var1.var
  )
}

# ------------------------------------------------------------
# 4. Loop over all days -- this is the expensive part.
#    ~16,000 days x 2 variables. Runs a progress message every
#    500 days so you can see it's alive (this will take a while).
# ------------------------------------------------------------
all_dates <- sort(unique(station_day_geo$date))
cat("\nKriging", length(all_dates), "days... this will take a while.\n")

district_day_list <- vector("list", length(all_dates))

for (i in seq_along(all_dates)) {
  d <- all_dates[i]
  m <- as.integer(format(d, "%m"))
  day_data <- station_day_geo %>% filter(date == d)
  
  maxt_result <- krige_one_day(day_data, "MaxT", maxt_variograms[[m]], district_sf)
  mint_result <- krige_one_day(day_data, "MinT", mint_variograms[[m]], district_sf)
  
  if (!is.null(maxt_result)) maxt_result <- maxt_result %>% rename(maxt_pred = pred, maxt_var = var)
  if (!is.null(mint_result)) mint_result <- mint_result %>% rename(mint_pred = pred, mint_var = var)
  
  if (!is.null(maxt_result) && !is.null(mint_result)) {
    district_day_list[[i]] <- full_join(maxt_result, mint_result, by = "district") %>%
      mutate(date = d)
  }
  
  if (i %% 500 == 0) cat("  ...", i, "/", length(all_dates), "days done\n")
}

district_day <- bind_rows(district_day_list)

cat("\nDone. district_day panel:", nrow(district_day), "rows,",
    n_distinct(district_day$district), "districts,",
    length(all_dates), "candidate days\n")

